# Externa API — never expose EXTERNA_API_KEY to the browser.
EXTERNA_API_URL=http://externa-core.test
# Prefer a key scoped to the starter's collections with read_only enabled (core 1.3.0+).
EXTERNA_API_KEY=

# Optional collection slug. Leave empty to auto-pick the first readable
# collection from GET /api/v1/collections (requires public or key Read).
EXTERNA_COLLECTION=
